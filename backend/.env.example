# Copy to .env and fill in. Never commit .env.

# "off" uses templates and calls no model. "live" needs ANTHROPIC_API_KEY.
LLM_MODE=off
ANTHROPIC_API_KEY=
LLM_MODEL=

# Optional. Capital One Nessie *sandbox* key; simulated data only.
NESSIE_API_KEY=

# Where program records come from.
#   fixtures  fictional development programs for ZIP 00000 (clearly labelled in the UI)
#   curated   verified records in app/data/programs/ (none yet, so every ZIP is unsupported)
PROGRAM_SOURCE=fixtures
