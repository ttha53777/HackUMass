# Copy to .env and fill in. Never commit .env.

# "off" uses templates and calls no model. "live" needs GEMINI_API_KEY.
LLM_MODE=off
GEMINI_API_KEY=
# Optional Gemini model ID; defaults to gemini-3.5-flash-lite.
LLM_MODEL=

# Optional. Capital One Nessie *sandbox* key; simulated data only.
NESSIE_API_KEY=

# Where program records come from.
#   fixtures  fictional development programs for ZIP 00000 (clearly labelled in the UI)
#   curated   verified records in app/data/programs/ (Hampshire County, MA)
PROGRAM_SOURCE=fixtures
